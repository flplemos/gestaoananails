# Copie para .env.local e preencha (Supabase > Project Settings > API Keys).
# Sem estas variáveis o app roda em modo demonstração (dados só no aparelho).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave pública VAPID para notificações push (a privada fica só no Supabase).
VITE_VAPID_PUBLIC_KEY=
